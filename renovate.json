{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/Berlin",
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Dependency Dashboard",
  "prHourlyLimit": 2,
  "prConcurrentLimit": 8,
  "rebaseWhen": "behind-base-branch",
  "rangeStrategy": "bump",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "postUpdateOptions": [
    "gomodTidy",
    "gomodUpdateImportPaths"
  ],
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ],
    "automerge": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Go toolchain version pinned in .mise.toml.",
      "managerFilePatterns": [
        "/(^|/)\\.mise\\.toml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)go\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)\""
      ],
      "depNameTemplate": "go",
      "packageNameTemplate": "go",
      "datasourceTemplate": "golang-version",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track the golangci-lint version the custom-gcl binary is built from.",
      "managerFilePatterns": [
        "/(^|/)\\.custom-gcl\\.yml$/"
      ],
      "matchStrings": [
        "(?:^|\\n)version:\\s*\"?(?<currentValue>v\\d+\\.\\d+\\.\\d+)\"?"
      ],
      "depNameTemplate": "golangci-lint",
      "packageNameTemplate": "golangci/golangci-lint",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "description": "Track the golint-sl plugin version baked into custom-gcl.",
      "managerFilePatterns": [
        "/(^|/)\\.custom-gcl\\.yml$/"
      ],
      "matchStrings": [
        "module:\\s*\"(?<depName>github\\.com/spechtlabs/golint-sl)\"\\s*\\n\\s*version:\\s*\"(?<currentValue>v[^\"]+)\""
      ],
      "datasourceTemplate": "go",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "mise is pinned as MISE_VERSION in every workflow that sets it up; move them at once, and only to a release a day old, the age mise-action waited for before the pin.",
      "matchDepNames": [
        "jdx/mise"
      ],
      "groupName": "mise",
      "groupSlug": "mise",
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Automerge digest, pin, patch, and minor updates once CI passes.",
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest",
        "patch",
        "minor"
      ],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Keep major updates explicit.",
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group GitHub Actions updates together.",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "description": "Group Go module updates together.",
      "matchManagers": [
        "gomod"
      ],
      "groupName": "Go modules",
      "groupSlug": "go-modules"
    },
    {
      "description": "Update .mise.toml and go.mod Go versions together.",
      "matchDatasources": [
        "golang-version"
      ],
      "matchDepNames": [
        "go"
      ],
      "groupName": "Go toolchain",
      "groupSlug": "go-toolchain",
      "rangeStrategy": "bump",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "dependencyDashboardApproval": false
    },
    {
      "description": "Leave the go directive in go.mod alone. It is the minimum language version, not the toolchain; bumping it to a full patch version makes it equal to the toolchain directive and go mod tidy then deletes the toolchain line. Renovate tracks the exact version through the toolchain directive instead.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "enabled": false
    },
    {
      "description": "Group the distroless base image's digest bumps on their own, so a base image refresh is one PR.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "gcr.io/distroless/**"
      ],
      "groupName": "distroless base image",
      "groupSlug": "distroless"
    },
    {
      "description": "Everything that ends up in the binary or the image ships as fix(deps), so release-please cuts a release and the published image picks it up: Go modules, the Go toolchain and the base image. Tooling, linters and Actions stay chore(deps) and release nothing.",
      "matchDatasources": [
        "go",
        "golang-version",
        "docker"
      ],
      "matchFileNames": [
        "go.mod",
        ".mise.toml",
        "Dockerfile"
      ],
      "semanticCommitType": "fix"
    },
    {
      "description": "golangci-lint is pinned in .mise.toml and .custom-gcl.yml; the two must never disagree. Linters ship nothing, so chore.",
      "matchDepNames": [
        "golangci-lint"
      ],
      "groupName": "golangci-lint",
      "groupSlug": "golangci-lint",
      "semanticCommitType": "chore"
    },
    {
      "description": "golint-sl is pinned in .custom-gcl.yml and .pre-commit-config.yaml; move both at once. Linters ship nothing, so chore.",
      "matchPackageNames": [
        "/golint-sl$/i"
      ],
      "groupName": "golint-sl",
      "groupSlug": "golint-sl",
      "semanticCommitType": "chore"
    },
    {
      "description": "gopls in .mise.toml is a go: tool for editors and ships nothing.",
      "matchFileNames": [
        ".mise.toml"
      ],
      "matchPackageNames": [
        "/gopls/"
      ],
      "semanticCommitType": "chore"
    }
  ]
}
